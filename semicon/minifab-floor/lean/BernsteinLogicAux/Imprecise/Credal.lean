/-
W408 imprecise-semantics leg — finite-state lower previsions.
-/
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Algebra.Order.Field.Rat
import Mathlib.Data.Finset.Lattice.Fold
import Mathlib.Data.Fintype.Prod
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-! # Finite-state lower previsions from finite credal families

**Source spec**: `hearth/research/bernstein-logic/W408-IMPRECISE-SEMANTICS-V2.md`
§1 (the canonical credal object), §3.2 (per-element linearity as the wiring
transport), §4.2 (superadditivity as the engine of the inf-friendly
composition direction).

A credal set on a finite space is presented here by a finite nonempty
*generating family* of `ℚ`-valued pmfs — an indexed family over a nonempty
`Fintype` — and the induced **lower prevision** `lowerE` is the `inf'` of the
elementwise expectations (dually `upperE`). Expectation is linear in the pmf,
so the inf over a finite family coincides with the inf over its convex hull:
finite generation loses nothing against the spec's convex-closed credal sets,
and it keeps every operator computable, which the tower-witness module's
`decide` proofs use.

Walley's coherence axioms are *theorems* of this presentation rather than
postulates: P1 (dominates the min) is `inf_le_lowerE`, P2 (positive
homogeneity) is `lowerE_smul`, P3 (superadditivity) is `lowerE_superadd`.
Conjugacy of the envelope pair is `upperE_eq_neg_lowerE_neg`. The
per-element linearity lemmas (`FinPMF.exp_add`, `FinPMF.exp_smul`) are the
spec's §3.2 realization: linearity of each precise element — not
independence — is what carries summed certificates across components.

Everything is computable; no `Decidable` escape hatches are needed
(cf. `lean-conventions.md`, checker-facing computability).
-/

namespace BernsteinLogic.Imprecise

open Finset

/-- A `ℚ`-valued probability mass function on a finite type. (The spec's §1
canonical object admits subprobability mass `γ ≤ 1`; this lane's scope is
full-mass pmfs per the Lean-leg brief — the subprobability extension is a
named future leg, not smuggled in.) -/
structure FinPMF (X : Type*) [Fintype X] where
  /-- Pointwise probability mass. -/
  prob : X → ℚ
  /-- All masses are nonnegative. -/
  nonneg : ∀ x, 0 ≤ prob x
  /-- Total mass one. -/
  total : ∑ x, prob x = 1

namespace FinPMF

variable {X : Type*} [Fintype X]

/-- Expectation (precise prevision) of `f` under `p`. -/
def exp (p : FinPMF X) (f : X → ℚ) : ℚ := ∑ x, p.prob x * f x

/-- Per-element **linearity of precise expectation** (additive part) — the
transport engine of spec §3.2: linearity of each precise element of the
credal set, not independence, is what carries summed certificates across
wired components. -/
theorem exp_add (p : FinPMF X) (f g : X → ℚ) :
    p.exp (fun x => f x + g x) = p.exp f + p.exp g := by
  simp [exp, mul_add, Finset.sum_add_distrib]

/-- Per-element linearity, scalar part. -/
theorem exp_smul (p : FinPMF X) (c : ℚ) (f : X → ℚ) :
    p.exp (fun x => c * f x) = c * p.exp f := by
  rw [exp, exp, Finset.mul_sum]
  exact Finset.sum_congr rfl fun x _ => mul_left_comm _ _ _

theorem exp_neg (p : FinPMF X) (f : X → ℚ) :
    p.exp (fun x => -f x) = -p.exp f := by
  simp [exp]

theorem exp_const (p : FinPMF X) (c : ℚ) : p.exp (fun _ => c) = c := by
  rw [exp, ← Finset.sum_mul, p.total, one_mul]

theorem exp_mono (p : FinPMF X) {f g : X → ℚ} (h : ∀ x, f x ≤ g x) :
    p.exp f ≤ p.exp g :=
  Finset.sum_le_sum fun x _ => mul_le_mul_of_nonneg_left (h x) (p.nonneg x)

theorem exp_congr (p : FinPMF X) {f g : X → ℚ} (h : ∀ x, f x = g x) :
    p.exp f = p.exp g :=
  Finset.sum_congr rfl fun x _ => by rw [h x]

end FinPMF

section Credal

variable {X : Type*} [Fintype X] {ι : Type*} [Fintype ι] [Nonempty ι]

/-- The **lower prevision** generated by a finite nonempty family of pmfs
(the credal set's generators): the spec §0 `E-lower` at a finite site. The
family need not be convex — `lowerE` depends only on its convex hull, since
expectation is linear in the pmf. -/
def lowerE (M : ι → FinPMF X) (f : X → ℚ) : ℚ :=
  univ.inf' univ_nonempty fun i => (M i).exp f

/-- The conjugate **upper prevision**. -/
def upperE (M : ι → FinPMF X) (f : X → ℚ) : ℚ :=
  univ.sup' univ_nonempty fun i => (M i).exp f

theorem lowerE_le_exp (M : ι → FinPMF X) (f : X → ℚ) (i : ι) :
    lowerE M f ≤ (M i).exp f := by
  unfold lowerE
  exact Finset.inf'_le _ (mem_univ i)

theorem exp_le_upperE (M : ι → FinPMF X) (f : X → ℚ) (i : ι) :
    (M i).exp f ≤ upperE M f := by
  unfold upperE
  exact Finset.le_sup' (fun j => (M j).exp f) (mem_univ i)

/-- The inf is taken *last*: a bound valid for every element is a bound on
the lower prevision. This one-liner is the "one quantifier, one direction,
no interchange" step of spec §3.2. -/
theorem le_lowerE {M : ι → FinPMF X} {f : X → ℚ} {a : ℚ}
    (h : ∀ i, a ≤ (M i).exp f) : a ≤ lowerE M f := by
  unfold lowerE
  exact Finset.le_inf' _ _ fun i _ => h i

theorem upperE_le {M : ι → FinPMF X} {f : X → ℚ} {a : ℚ}
    (h : ∀ i, (M i).exp f ≤ a) : upperE M f ≤ a := by
  unfold upperE
  exact Finset.sup'_le _ _ fun i _ => h i

/-- The lower envelope is attained (finite family). -/
theorem exists_eq_lowerE (M : ι → FinPMF X) (f : X → ℚ) :
    ∃ i, lowerE M f = (M i).exp f := by
  obtain ⟨i, _, h⟩ := Finset.exists_mem_eq_inf' (univ_nonempty) fun i => (M i).exp f
  exact ⟨i, h⟩

/-- The upper envelope is attained (finite family). -/
theorem exists_eq_upperE (M : ι → FinPMF X) (f : X → ℚ) :
    ∃ i, upperE M f = (M i).exp f := by
  obtain ⟨i, _, h⟩ := Finset.exists_mem_eq_sup' (univ_nonempty) fun i => (M i).exp f
  exact ⟨i, h⟩

theorem lowerE_congr {M : ι → FinPMF X} {f g : X → ℚ} (h : ∀ x, f x = g x) :
    lowerE M f = lowerE M g := by
  unfold lowerE
  exact Finset.inf'_congr _ rfl fun i _ => (M i).exp_congr h

theorem upperE_congr {M : ι → FinPMF X} {f g : X → ℚ} (h : ∀ x, f x = g x) :
    upperE M f = upperE M g := by
  unfold upperE
  exact Finset.sup'_congr _ rfl fun i _ => (M i).exp_congr h

/-- **Coherence P3: superadditivity** of the lower prevision — spec §4.2's
"inequality-algebraic engine behind *inf is the friendly direction*": summed
component lower bounds under-claim the composite (conservatism, never
overclaim). Proof shape: per element, per-element linearity, inf last. -/
theorem lowerE_superadd (M : ι → FinPMF X) (f g : X → ℚ) :
    lowerE M f + lowerE M g ≤ lowerE M (fun x => f x + g x) :=
  le_lowerE fun i => by
    rw [FinPMF.exp_add]
    exact add_le_add (lowerE_le_exp M f i) (lowerE_le_exp M g i)

/-- The conjugate fact: subadditivity of the upper prevision. -/
theorem upperE_subadd (M : ι → FinPMF X) (f g : X → ℚ) :
    upperE M (fun x => f x + g x) ≤ upperE M f + upperE M g :=
  upperE_le fun i => by
    rw [FinPMF.exp_add]
    exact add_le_add (exp_le_upperE M f i) (exp_le_upperE M g i)

/-- **Coherence P2: positive homogeneity** of the lower prevision. -/
theorem lowerE_smul (M : ι → FinPMF X) {c : ℚ} (hc : 0 ≤ c) (f : X → ℚ) :
    lowerE M (fun x => c * f x) = c * lowerE M f := by
  apply le_antisymm
  · obtain ⟨i, hi⟩ := exists_eq_lowerE M f
    calc lowerE M (fun x => c * f x) ≤ (M i).exp (fun x => c * f x) :=
          lowerE_le_exp M _ i
      _ = c * (M i).exp f := (M i).exp_smul c f
      _ = c * lowerE M f := by rw [← hi]
  · refine le_lowerE fun i => ?_
    rw [(M i).exp_smul c f]
    exact mul_le_mul_of_nonneg_left (lowerE_le_exp M f i) hc

/-- **Coherence P1**: the lower prevision dominates the pointwise min
(equivalently: accepts every sure gain). -/
theorem inf_le_lowerE [Nonempty X] (M : ι → FinPMF X) (f : X → ℚ) :
    (univ.inf' univ_nonempty f) ≤ lowerE M f :=
  le_lowerE fun i =>
    calc univ.inf' univ_nonempty f
        = (M i).exp (fun _ => univ.inf' univ_nonempty f) :=
          ((M i).exp_const _).symm
      _ ≤ (M i).exp f := (M i).exp_mono fun x => Finset.inf'_le _ (mem_univ x)

theorem lowerE_const (M : ι → FinPMF X) (c : ℚ) :
    lowerE M (fun _ => c) = c := by
  obtain ⟨i, hi⟩ := exists_eq_lowerE M (fun _ => c)
  rw [hi, (M i).exp_const]

theorem upperE_const (M : ι → FinPMF X) (c : ℚ) :
    upperE M (fun _ => c) = c := by
  obtain ⟨i, hi⟩ := exists_eq_upperE M (fun _ => c)
  rw [hi, (M i).exp_const]

theorem lowerE_mono (M : ι → FinPMF X) {f g : X → ℚ} (h : ∀ x, f x ≤ g x) :
    lowerE M f ≤ lowerE M g := by
  obtain ⟨i, hi⟩ := exists_eq_lowerE M g
  rw [hi]
  exact (lowerE_le_exp M f i).trans ((M i).exp_mono h)

theorem upperE_mono (M : ι → FinPMF X) {f g : X → ℚ} (h : ∀ x, f x ≤ g x) :
    upperE M f ≤ upperE M g := by
  obtain ⟨i, hi⟩ := exists_eq_upperE M f
  rw [hi]
  exact ((M i).exp_mono h).trans (exp_le_upperE M g i)

theorem lowerE_le_upperE (M : ι → FinPMF X) (f : X → ℚ) :
    lowerE M f ≤ upperE M f :=
  (lowerE_le_exp M f (Classical.arbitrary ι)).trans
    (exp_le_upperE M f (Classical.arbitrary ι))

/-- Conjugacy of the envelope pair: `upperE f = -lowerE (-f)`. The upper
prevision carries no independent information; the spec's `(E-lower, E-upper)`
pair is one object. -/
theorem upperE_eq_neg_lowerE_neg (M : ι → FinPMF X) (f : X → ℚ) :
    upperE M f = -lowerE M (fun x => -f x) := by
  apply le_antisymm
  · refine upperE_le fun i => ?_
    have h := lowerE_le_exp M (fun x => -f x) i
    rw [(M i).exp_neg] at h
    linarith
  · obtain ⟨i, hi⟩ := exists_eq_lowerE M (fun x => -f x)
    rw [hi, (M i).exp_neg, neg_neg]
    exact exp_le_upperE M f i

end Credal

end BernsteinLogic.Imprecise
