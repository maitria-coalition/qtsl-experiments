--- a/tiny-atari-2600/test/conftest.py
+++ b/tiny-atari-2600/test/conftest.py
@@ -0,0 +1,10 @@
+# House patch (4): guard upstream cocotb HDL tests against collection in
+# environments without a cocotb simulator stack. These are the vendor's own
+# hardware testbench drivers (cocotb + icarus/verilator), not house tests —
+# the house differential harness lives in ../../harness/ (atrcdiff + ale_trace).
+# See CORE-LEDGER.md, house patches.
+collect_ignore = []
+try:
+    import cocotb  # noqa: F401
+except ImportError:
+    collect_ignore = ["test.py", "test_record.py", "zealot.py"]
