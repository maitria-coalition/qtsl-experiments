  * Simple Atari 2600 PIA module.
  * Original source from: https://github.com/lawrie/ulx3s_atari_2600/blob/main/src/pia.v
  *
+ * HOUSE PATCH P1 : two-player SWCHA.
+ * Upstream duplicated joystick 0 into both SWCHA nibbles
+ * (`{buttons[6:3], buttons[6:3]}`), which feeds player A's directions to
+ * player B as well — a real-hardware divergence (SWCHA low nibble is the
+ * right-port joystick). Added `buttons1` and split the nibbles.
  */
 
 `default_nettype none
@@ -18,6 +23,7 @@
   output reg [7:0]                dat_o,
 
   input [6:0]                     buttons,
+  input [6:0]                     buttons1,
   input [3:0]                     sw,
   output [7:0]                    diag
 );
@@ -53,7 +59,7 @@
 
       if (valid_read_cmd) begin
         case (adr_i) 
-          7'h00: begin dat_o <= {buttons[6:3], buttons[6:3]}; end// SWCHA
+          7'h00: begin dat_o <= {buttons[6:3], buttons1[6:3]}; end// SWCHA (P1: high nibble = left port, low nibble = right port)
           7'h01: dat_o <= swa_dir; // SWACNT
           7'h02: dat_o <= {~sw[0], ~sw[1], 2'b11, sw[2], 1'b1, buttons[SELECT], buttons[RESET]}; // SWCHB
           7'h03: dat_o <= {2'b0, swb_dir[5:4], 1'b0, swb_dir[2], 2'b0}; // SWBCNT
